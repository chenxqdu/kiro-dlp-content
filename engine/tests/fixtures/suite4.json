[
  {
    "id": "S4-01",
    "suite": 4,
    "injection_point": "mcp",
    "content": {
      "tool": "deploy",
      "arguments": {
        "aws_key": "AKIATESTKEY1234567XY",
        "region": "cn-north-1"
      }
    },
    "content_kind": "mcp_call",
    "session_window": null,
    "expected": {
      "verdict": "block",
      "top_layer": "L0",
      "must_hit": [
        {
          "entity": "AWS_ACCESS_KEY",
          "action": "block"
        }
      ],
      "must_not_hit": [],
      "async_l4_category": null
    },
    "invariants": [
      "MCP 平铺参数 aws_key 内含 AKIA → BLOCK,field_path=aws_key"
    ],
    "verify_point": "MCP 平铺参数命中 AWS AK,field_path=键名",
    "needs_l3": false,
    "notes_expected": []
  },
