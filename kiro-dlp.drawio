    <mxGraphModel dx="1513" dy="1296" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;" value="Kiro DLP：在现有 SNI 透传代理上做「按 SNI 选择性 MITM」（方案D / 融合方案）" vertex="1">
          <mxGeometry height="30" width="1160" x="120" y="20" as="geometry" />
        </mxCell>
        <mxCell id="cn" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=10;fontSize=11;" value="国内团队 Kiro 客户端&#xa;(Electron/Node, Bearer token 认证)&#xa;+ 企业 CA 已注入 OS 信任库&#xa;  且 NODE_EXTRA_CA_CERTS 指向" vertex="1">
          <mxGeometry height="120" width="230" x="40" y="360" as="geometry" />
        </mxCell>
        <mxCell id="ec2box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;verticalAlign=top;fontSize=12;fontStyle=1;spacingTop=6;" value="EC2 (us-east-1, 现有 i-0455...；公有子网 EIP 3.214.48.79)" vertex="1">
          <mxGeometry height="600" width="560" x="360" y="120" as="geometry" />
        </mxCell>
        <mxCell id="nginx" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;fontSize=11;" value="nginx stream :443&#xa;ssl_preread on（只读 ClientHello SNI，不解密）&#xa;map $ssl_preread_server_name → 分流" vertex="1">
          <mxGeometry height="80" width="500" x="390" y="170" as="geometry" />
        </mxCell>
        <mxCell id="passthru" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;spacingLeft=10;fontSize=11;" value="① 透传腿（零改动，保持现状）&#xa;auth/SSO/其它域名：&#xa;oidc / portal.sso / *.awsapps.com&#xa;management.kiro.dev / cli.kiro.dev&#xa;→ proxy_pass $name:443（不解密）&#xa;⚠ 认证流量绝不 bump" vertex="1">
          <mxGeometry height="150" width="230" x="390" y="300" as="geometry" />
        </mxCell>
        <mxCell id="bumpleg" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;spacingLeft=10;fontSize=11;" value="② 选择性 bump 腿（新增）&#xa;仅 runtime.us-east-1.kiro.dev&#xa;→ proxy_pass 127.0.0.1:8443" vertex="1">
          <mxGeometry height="80" width="230" x="660" y="300" as="geometry" />
        </mxCell>
        <mxCell id="mitm" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;fontSize=10;" value="本地 TLS 终止 DLP 代理 :8443&#xa;(mitmproxy 自研 addon — 非 LiteLLM)&#xa;• 用企业 CA 终止 TLS，拿明文&#xa;• 解析 CodeWhisperer 协议&#xa;  (x-amz-json-1.0, GenerateAssistantResponse)&#xa;• 抽取 prompt + 文件/shell 上下文&#xa;• 同步调 DDS REST + Llama Guard 判定&#xa;• 命中→阻断(4xx)；放行→原样上游&#xa;• 响应 event-stream 只读转发(stream=True)" vertex="1">
          <mxGeometry height="180" width="270" x="620" y="420" as="geometry" />
        </mxCell>
        <mxCell id="dds" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;fontSize=10;" value="Symantec DDS 容器 / Presidio&#xa;(同 VPC，内容不出租户)&#xa;POST /v2.0/DetectionRequests" vertex="1">
          <mxGeometry height="80" width="200" x="960" y="420" as="geometry" />
        </mxCell>
        <mxCell id="llama" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;fontSize=10;" value="Llama Guard (Ollama, 本地)&#xa;入站有害意图分类&#xa;⚠ 非防泄漏检测器" vertex="1">
          <mxGeometry height="80" width="200" x="960" y="520" as="geometry" />
        </mxCell>
        <mxCell id="vpce" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=center;fontSize=11;" value="PrivateLink VPCE / 公网&#xa;→ 真实 runtime.us-east-1.kiro.dev&#xa;codewhisperer / q (后端)" vertex="1">
          <mxGeometry height="90" width="200" x="960" y="180" as="geometry" />
