#############################################
# Kiro DLP 验证节点 部署配置（方案二：选择性 bump + VPC 内 DLP 联动）
#
# ⚠️ 这是一台【独立的验证节点】，与生产 SNI 透传节点（us-east-1，ID/EIP 见内部部署记录）
#    完全隔离，且【复用】DLP 引擎主机所在 VPC，以便私网直达判定服务。
#    独立 EIP / IAM / state 文件；绝不共用生产 deploy/ 目录。
#
# 用法：cp config.env.example config.env，按注释填入你自己的账号资源，再执行 ./deploy.sh
#    本文件是模板；config.env 已被 .gitignore 排除，真实基础设施 ID 不入仓。
#############################################

# ===== AWS 基础配置（region/backend 彻底解耦，规格 D5）=====
# AWS_REGION          = 资源落地区（proxy EC2/EIP/SG 建在哪）。必须 = DLP 主机所在区，
#                       才能与 DLP 私网 IP 同 VPC 直达。
# KIRO_BACKEND_REGION = 仅用于拼 Kiro 域名（SNI/bump 上游）。Kiro runtime 在 us-east-1，
#                       域名固定 runtime.us-east-1.kiro.dev —— 与资源落地区无关。
#   ★ 若把域名也用 AWS_REGION 拼，会得到不存在的 runtime.us-west-2.kiro.dev，握手 hang。
export AWS_REGION="us-west-2"                  # 改成你的 DLP 主机所在区
export KIRO_BACKEND_REGION="us-east-1"         # Kiro 后端区（拼域名用），一般不改
export PROJECT_NAME="kiro-dlp-mitm-v2"         # 资源前缀/标签（避免与生产/旧验证节点 IAM 撞名）

# ===== 网络：复用 DLP 主机所在 VPC / 子网（不新建，规格 D5）=====
# 复用后 proxy 与 DLP 同 VPC 同 AZ，DLP_HOST_PRIVATE_IP:9000 私网直达。
export EXISTING_VPC_ID=""                       # 例：vpc-0123456789abcdef0（DLP 主机所在 VPC）
export EXISTING_SUBNET_ID=""                    # 例：subnet-0123456789abcdef0（公有子网，与 DLP 同 AZ）
# 以下新建网段参数在复用模式下不生效（保留仅为脚本另一分支兼容）。
export NEW_VPC_CIDR="10.198.0.0/16"
export NEW_SUBNET_CIDR="10.198.1.0/24"
export NEW_SUBNET_AZ=""

# ===== EC2 配置 =====
export INSTANCE_TYPE="c6g.large"               # arm64 Graviton；换类型须同步改 INSTANCE_ARCH
export INSTANCE_ARCH="arm64"                    # 必须与 INSTANCE_TYPE 匹配
export EBS_SIZE_GB="20"
export KEY_NAME=""                              # 留空仅用 SSM 登录（推荐）

# ===== 安全组：管理入站来源 =====
# 默认：仅 SSM，proxy 本机自测，不开公网 443、不开 22。
export ADMIN_SSH_CIDR=""                        # 空 = 不开 22（用 SSM Session Manager）
export INGRESS_443_CIDR=""                      # 空 = 不开公网 443（本机 loopback 自测 + SSM）

# ===== PrivateLink（VPCE）开关 =====
export ENABLE_PRIVATELINK="false"               # bump 上游走公网出口；无需 q/codewhisperer VPCE

# ===== DLP 判定服务联动（方案二核心）=====
export DLP_HOST_INSTANCE_ID=""                  # 例：i-0123456789abcdef0（DLP 引擎主机，同 VPC）
export DLP_HOST_SG_ID=""                        # 例：sg-0123456789abcdef0（deploy 会给它加 9000 入站）
export DLP_HOST_PRIVATE_IP=""                   # 例：172.31.x.y（DLP 主机私网 IP）
export DLP_INSPECT_PORT="9000"                  # 判定服务端口
export DLP_INSPECT_URL="http://${DLP_HOST_PRIVATE_IP}:${DLP_INSPECT_PORT}/inspect"  # addon 调它做裁决
export DLP_FAIL_MODE="closed"                   # 规格 D4：默认 fail-closed（安全）；灰度可临时 open
export DLP_TIMEOUT="8.0"                        # addon 判定调用总超时秒（按 Presidio p99 标定）
# ⚠ L4 sync 模式预算：DLP 服务端 sync 会在同步腿(L0–L3.5)之后再等 L4 至多 DLP_L4_TIMEOUT_MS。
#   此 DLP_TIMEOUT 须 ≥ L0–L3.5 实测预算 + DLP_L4_TIMEOUT_MS(默认 4s)，否则 addon 先超时
#   → 503 → fail-closed（安全但非预期的 BLOCK）。L4 三态开关本身在 DLP 主机的
#   docker-compose.dlp-http.yml 里配（DLP_L4_MODE 等），不在此 addon 侧文件。
export DLP_MAX_BODY_BYTES="8388608"             # addon 明文 body 上限 8 MiB（超限恒 fail-closed）

# ===== nginx SNI 白名单域名（全部用 KIRO_BACKEND_REGION 拼，规格 D5）=====
# deploy.sh 对 MITM_BUMP_DOMAIN 那条特判为转发本机 mitmproxy，其余 L4 透传。
export SNI_DOMAINS=(
  "codewhisperer.${KIRO_BACKEND_REGION}.amazonaws.com"
  "q.${KIRO_BACKEND_REGION}.amazonaws.com"
  "cli.kiro.dev"
  "runtime.${KIRO_BACKEND_REGION}.kiro.dev"
  "management.${KIRO_BACKEND_REGION}.kiro.dev"
)

#############################################
# ===== MITM 选择性 bump 配置 =====
#############################################
# 唯一被 bump（解密→DLP 裁决→重加密/短路）的域名。必须是 SNI_DOMAINS 中的一员。
# 置空 = 退化为全透传（一键回滚开关）。
export MITM_BUMP_DOMAIN="runtime.${KIRO_BACKEND_REGION}.kiro.dev"

# nginx 把 bump 域连接 proxy_pass 到本机此端口；mitmproxy 在此 TLS 终结。
export MITM_PORT="8443"

# ===== 企业 CA（EC2 现场生成，私钥不出机）=====
export MITM_CA_DIR="/etc/mitm/certs"                       # mitmproxy confdir
export MITM_CA_ROOT_CN="Kiro-DLP-Verify Root CA"           # 根 CA（客户端信任锚）
export MITM_CA_INTER_CN="Kiro-DLP-Verify Issuing CA"       # 签发 CA（Name Constraints 挂这里）
export MITM_CA_PERMITTED_DNS="kiro.dev"                    # NC 白名单：只能签 kiro.dev 及子域
export MITM_CA_ROOT_DAYS="3650"
export MITM_CA_INTER_DAYS="1825"

# ===== mitmproxy 版本约束 =====
export MITM_MIN_MAJOR="11"                                 # ≥v11（修复请求走私 / mitmweb SSRF→RCE）
